# Supabase Configuration
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Service role key is used exclusively server-side in secure API routes/scripts:
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini Models & Speech Configuration (safe defaults in code)
# GEMINI_ANALYSIS_MODEL (Optional, default: "gemini-3.5-flash-lite")
GEMINI_ANALYSIS_MODEL="gemini-3.5-flash-lite"

# GEMINI_ANALYSIS_FALLBACK_MODEL (Optional, default: "gemini-3.5-flash")
GEMINI_ANALYSIS_FALLBACK_MODEL="gemini-3.5-flash"

# GEMINI_TTS_MODEL (Optional, default: "gemini-2.5-flash-preview-tts")
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# GEMINI_TTS_FALLBACK_MODEL (Optional, default: "gemini-2.5-pro-preview-tts")
GEMINI_TTS_FALLBACK_MODEL="gemini-2.5-pro-preview-tts"

# GEMINI_TTS_VOICE (Optional, default: "Kore")
GEMINI_TTS_VOICE="Kore"

# Upstash Redis & Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# DAILY_LESSON_LIMIT (Optional, default: 3)
DAILY_LESSON_LIMIT=3

# APP_URL: Host URL for self-referential links, OAuth callbacks, and API endpoints
APP_URL="MY_APP_URL"
